[*]
root = true
charset = utf-8
crlf = false
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.py]	indent_style = space	indent_size = 4

[*.rs]	indent_style = space	indent_size = 4

[*.ts]	indent_style = space	indent_size = 2
[*.js]	indent_style = space	indent_size = 2

[Makefile]	indent_style = tab

[*.yml]	indent_style = space	indent_size = 2
[*.json]	indent_style = space	indent_size = 2
[*.md]	indent_style = space	indent_size = 2

[*.{sh,c,c++,go,lua,css,html}]	indent_style = space	indent_size = 4